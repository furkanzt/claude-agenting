{
  "description": "agenting: a two-stage routing gate on the Workflow tool (Stage 1 denies agent() calls with no model/agentType or no effort; Stage 2 asks for plan approval in manual mode and steps aside with a systemMessage in auto mode), a finish check that warns when a completed Workflow's journal shows agents that never returned, a mid-session cache-cost tripwire, and a SessionStart line that carries mode, disposition and the workflows opt-in across compaction.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/workflow-routing-guard.py\"",
            "timeout": 10,
            "statusMessage": "Checking workflow agent routing..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/cache-tripwire.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/workflow-finish-check.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|compact|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/session-continuity.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
